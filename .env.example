DATABASE_URL=postgresql://wow_sim:wow_sim_local@127.0.0.1:5432/wow_sim
GAME_SERVER_URL=http://127.0.0.1:8788
HOST=127.0.0.1
PORT=8788
GAME_WORKER_INTERVAL_MS=100
GAME_WORKER_LIMIT=100
# Maximum offline activity duration; configure the same value on API and worker.
GAME_OFFLINE_LIMIT_MS=7200000

# XP rate (0–1000, decimals allowed); use the same value on API and worker.
GAME_XP_MULTIPLIER=2

APP_ORIGIN=http://127.0.0.1:5173
AUTH_TRUST_PROXY_HOPS=0

# Private simulation service; generate a fresh 32–128 character URL-safe secret.
# This is service-to-service authentication, never a browser environment variable.
SIMULATION_TOKEN=
SIMULATION_URL=http://127.0.0.1:8790
SIMULATION_PORT=8790
SIMULATION_WORKERS=1
SIMULATION_MAX_INSTANCES=128
SIMULATION_CHECKPOINT_MS=5000
# Inactive rooms with no authenticated observer are persisted and unloaded after this delay.
SIMULATION_IDLE_RETIRE_MS=60000

# Container role: game runs API + private simulation as separate processes.
# api and simulation remain available for explicitly managed separate processes.
# game generates an ephemeral internal token if SIMULATION_TOKEN is blank.
SERVICE_ROLE=game
# Optional isolated namespace; runtime release images default to wow_sim_v2.
# GAME_DATABASE_SCHEMA=wow_sim_v2
