FROM node:24.11.1-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8788 SERVICE_ROLE=game
ENV GAME_DATABASE_SCHEMA=wow_sim_v2
COPY package.json package-lock.json ./
COPY scripts/install-git-hooks.mjs ./scripts/
COPY packages ./packages
RUN npm ci --omit=dev && npm cache clean --force
COPY apps/game-server ./apps/game-server
COPY apps/game-worker ./apps/game-worker
COPY apps/simulation-host ./apps/simulation-host
COPY scripts/start-runtime.mjs scripts/game-runtime.mjs ./scripts/
USER node
EXPOSE 8788
CMD ["node", "scripts/start-runtime.mjs"]
