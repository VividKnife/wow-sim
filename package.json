{
  "name": "wow-sim",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "data:compile": "node scripts/compile-boss-rooms.mjs && node scripts/compile-runtime-content.mjs && node scripts/compile-game-data.mjs",
    "data:check": "node scripts/compile-boss-rooms.mjs --check && node scripts/compile-runtime-content.mjs --check && node scripts/compile-game-data.mjs --check",
    "world:check": "node scripts/audit-world-content.mjs --check && node scripts/validate-world-playability.mjs",
    "content:measure": "node scripts/measure-client-content.mjs",
    "combat:audit": "node scripts/audit-spell-contracts.mjs",
    "combat:audit:check": "node scripts/audit-spell-contracts.mjs --check",
    "simulation:recovery": "node --env-file-if-exists=.env apps/simulation-host/scripts/verify-process-recovery.ts",
    "simulation:host": "node --env-file-if-exists=.env apps/simulation-host/src/main.ts",
    "game:server": "node --env-file-if-exists=.env apps/game-server/src/main.ts",
    "game:worker": "node --env-file-if-exists=.env apps/game-worker/src/main.ts",
    "game:server:dev": "node --watch --env-file-if-exists=.env apps/game-server/src/main.ts",
    "game:worker:dev": "node --watch --env-file-if-exists=.env apps/game-worker/src/main.ts",
    "simulation:test": "node --test --test-concurrency=1 packages/bot-ai/test/*.test.mjs packages/combat-core/test/*.test.ts packages/simulation-tests/*.test.ts apps/simulation-host/test/*.test.ts apps/game-server/test/dungeon-admission.test.ts packages/persistence/test/simulation.test.ts packages/game-domain/test/resident-characters.test.ts packages/game-domain/test/resident-participants.test.ts packages/game-domain/test/resident-transfer.test.ts packages/game-domain/test/dungeon-entry.test.ts packages/game-domain/test/simulation-clock.test.ts packages/game-domain/test/npc-characters.test.ts packages/game-domain/test/resource-events.test.mjs packages/game-domain/test/auto-attack-events.test.mjs packages/game-domain/test/dot-events.test.mjs packages/game-domain/test/periodic-events.test.mjs packages/game-domain/test/ground-events.test.mjs packages/game-domain/test/enemy-aura-events.test.mjs packages/game-domain/test/instance-presentation.test.mjs packages/game-domain/test/boss-room.test.ts packages/game-domain/test/scene-space.test.mjs packages/game-domain/test/raid-battlefield.test.ts packages/game-domain/test/arena-event-queue.test.mjs",
    "simulation:bench": "node apps/simulation-host/scripts/benchmark.ts",
    "simulation:transfer-test": "node --test --test-concurrency=1 packages/game-domain/test/resident-transfer.test.ts apps/simulation-host/test/transfer-alignment.test.ts apps/simulation-host/test/realtime-dungeon-transfer.test.ts apps/simulation-host/test/transfer-barrier.test.ts packages/persistence/test/simulation.test.ts packages/game-domain/test/resident-characters.test.ts",
    "demo:molten-core": "node apps/web/scripts/serve-molten-core-demo.mjs",
    "demo:classic-ui": "node apps/web/scripts/serve-classic-ui-demo.mjs",
    "demo:journey-ui": "node apps/web/scripts/serve-journey-ui-demo.mjs",
    "simulation:transfer-check": "node --env-file-if-exists=.env apps/simulation-host/scripts/verify-transfer-seal.ts",
    "social:test": "node --test packages/game-domain/test/dungeon-entry.test.ts packages/game-domain/test/social.test.ts apps/game-server/test/social.test.ts packages/game-domain/test/npc-match-supply.test.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs"
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
